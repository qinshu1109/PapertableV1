  "body": [
    {
      "from": 0,
      "to": 0.24,
      "sid": 1,
      "location": 2,
      "content": "Hello",
      "music": 0
    },
    {
      "from": 0.24,
      "to": 0.66,
      "sid": 2,
      "location": 2,
      "content": "大家好",
      "music": 0
    },
    {
      "from": 0.66,
      "to": 3.38,
      "sid": 3,
      "location": 2,
      "content": "前两天有一个我的视频观众找到我做这个咨询",
      "music": 0
    },
    {
      "from": 3.38,
      "to": 4.32,
      "sid": 4,
      "location": 2,
      "content": "就想让我帮他看看",
      "music": 0
    },
    {
      "from": 4.32,
      "to": 7.02,
      "sid": 5,
      "location": 2,
      "content": "他自己开发的一个发票管理的一个产品",
      "music": 0
    },
    {
      "from": 7.02,
      "to": 8.26,
      "sid": 6,
      "location": 2,
      "content": "是一个IOS的app",
      "music": 0
    },
    {
      "from": 8.26,
      "to": 9.78,
      "sid": 7,
      "location": 2,
      "content": "他自己完全VIP cording出来的",
      "music": 0
    },
    {
      "from": 9.78,
      "to": 11.14,
      "sid": 8,
      "location": 2,
      "content": "而且他还不太一样",
      "music": 0
    },
    {
      "from": 11.14,
      "to": 13.06,
      "sid": 9,
      "location": 2,
      "content": "他是这种传统行业的销售",
      "music": 0
    },
    {
      "from": 13.06,
      "to": 15.88,
      "sid": 10,
      "location": 2,
      "content": "他是真正的完全没有任何互联网公司",
      "music": 0
    },
    {
      "from": 15.88,
      "to": 17.18,
      "sid": 11,
      "location": 2,
      "content": "这种背景的一个小白",
      "music": 0
    },
    {
      "from": 17.18,
      "to": 18.48,
      "sid": 12,
      "location": 2,
      "content": "然后他想让我帮他看看",
      "music": 0
    },
    {
      "from": 18.48,
      "to": 20.08,
      "sid": 13,
      "location": 2,
      "content": "他的这个UIUX做的怎么样",
      "music": 0
    },
    {
      "from": 20.08,
      "to": 21.4,
      "sid": 14,
      "location": 2,
      "content": "功能有什么可以加的",
      "music": 0
    },
    {
      "from": 21.4,
      "to": 24.03,
      "sid": 15,
      "location": 2,
      "content": "还有怎么样去射媒进行一些曝光",
      "music": 0
    },
    {
      "from": 24.03,
      "to": 26.45,
      "sid": 16,
      "location": 2,
      "content": "然后在这个呃我们语音的过程中啊",
      "music": 0
    },
    {
      "from": 26.45,
      "to": 28.43,
      "sid": 17,
      "location": 2,
      "content": "他投屏给我演示了一下他做的这个应用",
      "music": 0
    },
    {
      "from": 28.43,
      "to": 31.15,
      "sid": 18,
      "location": 2,
      "content": "然后我发现他这个应用做的比我想象中的好啊",
      "music": 0
    },
    {
      "from": 31.15,
      "to": 33.31,
      "sid": 19,
      "location": 2,
      "content": "这个应用就是这个叫做报销助手",
      "music": 0
    },
    {
      "from": 33.31,
      "to": 35.11,
      "sid": 20,
      "location": 2,
      "content": "虽然说他图标看着像一个官方应用",
      "music": 0
    },
    {
      "from": 35.11,
      "to": 37.43,
      "sid": 21,
      "location": 2,
      "content": "然后底下这个宣传图做的不是很好看啊",
      "music": 0
    },
    {
      "from": 37.43,
      "to": 40.19,
      "sid": 22,
      "location": 2,
      "content": "但其实它的应用做的UI很清爽",
      "music": 0
    },
    {
      "from": 40.19,
      "to": 41.83,
      "sid": 23,
      "location": 2,
      "content": "而且UX也很符合直觉",
      "music": 0
    },
    {
      "from": 41.83,
      "to": 43.39,
      "sid": 24,
      "location": 2,
      "content": "功能也做的很用心",
      "music": 0
    },
    {
      "from": 43.39,
      "to": 45.77,
      "sid": 25,
      "location": 2,
      "content": "他可以直接去和这个邮箱绑定",
      "music": 0
    },
    {
      "from": 45.77,
      "to": 49.37,
      "sid": 26,
      "location": 2,
      "content": "然后你平时拍照的这些吃饭的这些小票",
      "music": 0
    },
    {
      "from": 49.37,
      "to": 49.73,
      "sid": 27,
      "location": 2,
      "content": "这些的",
      "music": 0
    },
    {
      "from": 49.73,
      "to": 52.09,
      "sid": 28,
      "location": 2,
      "content": "它可以识别上面的一些商家信息",
      "music": 0
    },
    {
      "from": 52.09,
      "to": 53.89,
      "sid": 29,
      "location": 2,
      "content": "然后去邮箱找到对应的发票",
      "music": 0
    },
    {
      "from": 53.89,
      "to": 56.23,
      "sid": 30,
      "location": 2,
      "content": "并且记录他的这个呃金额",
      "music": 0
    },
    {
      "from": 56.23,
      "to": 58.07,
      "sid": 31,
      "location": 2,
      "content": "而且我看他里面有很多的记录",
      "music": 0
    },
    {
      "from": 58.07,
      "to": 59.83,
      "sid": 32,
      "location": 2,
      "content": "就明显就是他自己用了很长时间",
      "music": 0
    },
    {
      "from": 59.83,
      "to": 62.75,
      "sid": 33,
      "location": 2,
      "content": "而且基于自己的实际需求不断去迭代的",
      "music": 0
    },
    {
      "from": 62.75,
      "to": 63.87,
      "sid": 34,
      "location": 2,
      "content": "然后他给我看了一个",
      "music": 0
    },
    {
      "from": 63.87,
      "to": 66.24,
      "sid": 35,
      "location": 2,
      "content": "他自己发的一个社媒的一条视频",
      "music": 0
    },
    {
      "from": 66.24,
      "to": 68.68,
      "sid": 36,
      "location": 2,
      "content": "内容里面就是他自己类似于我现在这种内容",
      "music": 0
    },
    {
      "from": 68.68,
      "to": 71.64,
      "sid": 37,
      "location": 2,
      "content": "内容形式就是在露脸介绍他的产品",
      "music": 0
    },
    {
      "from": 71.64,
      "to": 73.86,
      "sid": 38,
      "location": 2,
      "content": "但是那条内容的数据非常惨",
