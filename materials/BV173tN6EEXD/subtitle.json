    },
    {
      "from": 73.86,
      "to": 75.54,
      "sid": 39,
      "location": 2,
      "content": "但是只有七个播放",
      "music": 0
    },
    {
      "from": 75.54,
      "to": 77.52,
      "sid": 40,
      "location": 2,
      "content": "我觉得估计是被限流了",
      "music": 0
    },
    {
      "from": 77.52,
      "to": 78.9,
      "sid": 41,
      "location": 2,
      "content": "但是即便是不限流",
      "music": 0
    },
    {
      "from": 78.9,
      "to": 80.66,
      "sid": 42,
      "location": 2,
      "content": "我也觉得其实没有太大的吸引力",
      "music": 0
    },
    {
      "from": 80.66,
      "to": 82.84,
      "sid": 43,
      "location": 2,
      "content": "就是那条视频现在这个时代啊",
      "music": 0
    },
    {
      "from": 82.84,
      "to": 84.08,
      "sid": 44,
      "location": 2,
      "content": "因为我们作为一个产品",
      "music": 0
    },
    {
      "from": 84.08,
      "to": 86.56,
      "sid": 45,
      "location": 2,
      "content": "它的成本极大的降低了",
      "music": 0
    },
    {
      "from": 86.56,
      "to": 89.16,
      "sid": 46,
      "location": 2,
      "content": "尤其是一些呃独立开发比较简单",
      "music": 0
    },
    {
      "from": 89.16,
      "to": 90.96,
      "sid": 47,
      "location": 2,
      "content": "可以web coding的这种产品",
      "music": 0
    },
    {
      "from": 90.96,
      "to": 92.16,
      "sid": 48,
      "location": 2,
      "content": "其实有非常非常多",
      "music": 0
    },
    {
      "from": 92.16,
      "to": 93.91,
      "sid": 49,
      "location": 2,
      "content": "但是产品多了之后",
      "music": 0
    },
    {
      "from": 93.91,
      "to": 97.92,
      "sid": 50,
      "location": 2,
      "content": "大家对于这个好产品这个要求的阈值也更高了",
      "music": 0
    },
    {
      "from": 97.92,
      "to": 100.48,
      "sid": 51,
      "location": 2,
      "content": "我们的产品想要从这么多产品里面去脱颖而出",
