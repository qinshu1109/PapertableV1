    },
    {
      "from": 120.73,
      "to": 122.51,
      "sid": 61,
      "location": 2,
      "content": "我这个产品如果发到社媒上面去",
      "music": 0
    },
    {
      "from": 122.51,
      "to": 124.17,
      "sid": 62,
      "location": 2,
      "content": "大家会是怎么样的一个反馈",
      "music": 0
    },
    {
      "from": 124.17,
      "to": 126.81,
      "sid": 63,
      "location": 2,
      "content": "如果只是单纯的解决大家的一个问题",
      "music": 0
    },
    {
      "from": 126.81,
      "to": 128.91,
      "sid": 64,
      "location": 2,
      "content": "那么它是很难被大家知道的",
      "music": 0
    },
    {
      "from": 128.91,
      "to": 131.09,
      "sid": 65,
      "location": 2,
      "content": "和你类似的产品都在不断的去做推广",
